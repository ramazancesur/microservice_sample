# ╔══════════════════════════════════════════════════════════════════╗
# ║           Banking Microservice Platform — .gitignore           ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Operating System ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── IDE / Editor ─────────────────────────────────────────────────
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
*.code-workspace

# Eclipse
.project
.classpath
.settings/
.factorypath
bin/

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# Cursor
.cursor/

# ─── Java / Maven (microbackend) ─────────────────────────────────
# Build output
**/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper (binary)
.mvn/wrapper/maven-wrapper.jar

# Spring Boot
*.jar
!.mvn/wrapper/*.jar
spring-shell.log

# Application local overrides
**/application-local.yml
**/application-local.properties
**/application-dev.yml

# ─── Node.js / Frontend (microui) ────────────────────────────────
# Dependencies
**/node_modules/
.pnp
.pnp.js

# Build output
**/dist/
**/build/
*.tsbuildinfo

# Vite
*.local
.vite/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager lock (root only, workspace lock dosyası hariç)
# package-lock.json workspace root'ta kalmalı, diğerleri ignore
microui/**/package-lock.json
!microui/package-lock.json

# ─── Test / Coverage ─────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
surefire-reports/

# ─── Docker ──────────────────────────────────────────────────────
docker-compose.override.yml
.docker/

# ─── Environment / Secrets ───────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.cert
**/credentials.json
**/secrets.yml
**/secrets.yaml

# ─── Logs ────────────────────────────────────────────────────────
*.log
logs/

# ─── ELK Stack Data (Docker volumes — zaten dışarıda ama emin ol)
elasticsearch_data/

# ─── Miscellaneous ───────────────────────────────────────────────
*.bak
*.tmp
*.temp
*.orig
*.rej
*.patch
